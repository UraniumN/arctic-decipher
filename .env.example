# =============================================================================
# LeakTrace Environment Variables
# Copy to .env and fill in values. Generate keys with: openssl rand -hex 24
# =============================================================================

# --- Shared Secrets (must match across services) ---
INGEST_KEY=                          # Tracer + ERP (must be identical)
READ_KEY=                            # Tracer (dashboard viewer key)
ADMIN_KEY=                           # ERP (admin operations key)
DASHBOARD_ORIGIN=http://localhost:5173  # Exact origin, no trailing slash

# --- Tracer (Agent A) ---
DATABASE_URL=                        # Pooled Postgres connection string with sslmode=require

# --- ERP (Agent B) ---
HMAC_KEY=                            # Custodian secret for pseudonymization
TRACER_URL=http://localhost:8000     # Tracer base URL, no trailing slash
